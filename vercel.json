{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/investing", "destination": "/investor-builder", "permanent": true },
    { "source": "/quiz", "destination": "/education#first-time-buyers", "permanent": true },
    { "source": "/refi-quiz", "destination": "/refi1", "permanent": true },
    { "source": "/iq", "destination": "/education", "permanent": true },
    { "source": "/blog/author/:path*", "destination": "/blog", "permanent": true },
    { "source": "/store/:path*", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
